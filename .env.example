# Copy to .env (never commit .env). Everything here is OPTIONAL:
# without it, AgentFuzz runs fully offline (committed corpus, nearsim anchoring).

# --- Prompt-layer generator / live planner (NEAR AI Cloud, OpenAI-compatible) ---
NEAR_AI_API_KEY=
# AGENTFUZZ_LLM_BASE_URL=https://cloud-api.near.ai/v1
# AGENTFUZZ_MODEL=deepseek-ai/DeepSeek-V3.1

# --- Testnet anchoring of report hashes ---
# A testnet account you control (create one: `near account create-account sponsor-by-faucet-service`)
NEAR_ACCOUNT_ID=
# ed25519:... secret key of that account (full access)
NEAR_PRIVATE_KEY=
# Scoreboard contract; `agentfuzz scoreboard-deploy` creates scoreboard.<NEAR_ACCOUNT_ID>
SCOREBOARD_CONTRACT_ID=
# NEAR_RPC_URL=https://test.rpc.fastnear.com
