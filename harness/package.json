{
  "name": "agentfuzz-harness",
  "version": "0.1.0",
  "description": "AgentFuzz: red-team harness for NEAR agent-wallet guard contracts",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentfuzz": "./bin/agentfuzz.mjs"
  },
  "scripts": {
    "agentfuzz": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fuzz": "tsx src/cli.ts fuzz",
    "demo-offline": "tsx src/cli.ts demo-offline",
    "report": "tsx src/cli.ts report"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "fast-check": "^4.10.2",
    "near-api-js": "^7.4.0",
    "openai": "^7.54.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
